# Copie ce fichier en .env et remplis-le. Ne JAMAIS committer .env.

# --- Obligatoire ---------------------------------------------------------

# Compte Gmail démo connecté dans Brave : celui qui reçoit les demandes et répond
DEMO_EMAIL=table.en.freelance@gmail.com
SIGNATURE=Table En

# Token de l'API locale screenpipe. Pour l'obtenir (une seule fois) :
#   "%LOCALAPPDATA%\screenpipe\bun.exe" x screenpipe@latest auth token
SCREENPIPE_LOCAL_API_KEY=

# --- Optionnel -------------------------------------------------------------

# Rédaction par Claude (sinon : modèle de réponse + faits retrouvés)
# ANTHROPIC_API_KEY=

# Entraînement uniquement : expéditeur « client » des demandes envoyées par SMTP
SENDER_EMAIL=karim.studionova@gmail.com
SENDER_NAME=Karim - Studio Nova
# REPLY_TO=
# Brevo : Paramètres > SMTP & API > SMTP (login xxxx@smtp-brevo.com + clé SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=xxxxxxx@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-xxxxxxxx
# Variante Gmail : SMTP_HOST=smtp.gmail.com, SMTP_LOGIN=<l'adresse>, SMTP_PASSWORD=<mot de passe d'application>

# BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# FILES_DIR=%USERPROFILE%\Documents\Freelance-Demo
